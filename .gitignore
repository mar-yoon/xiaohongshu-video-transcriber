# ffmpeg 二进制（由 install.sh 自动下载）
bin/ffmpeg

# 运行时产生的音频/视频文件
audio/*

# 转录输出（保留目录结构，不保留内容）
transcripts/*
!transcripts/.gitkeep

# Python
